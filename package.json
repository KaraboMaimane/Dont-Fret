{
  "name": "dont-fret",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "native:assets:android": "npx @capacitor/assets generate --android --assetPath assets --iconBackgroundColor '#101c31' --iconBackgroundColorDark '#08101f' --splashBackgroundColor '#050b16' --splashBackgroundColorDark '#050b16'",
    "native:assets:ios": "npx @capacitor/assets generate --ios --assetPath assets --iconBackgroundColor '#101c31' --iconBackgroundColorDark '#08101f' --splashBackgroundColor '#050b16' --splashBackgroundColorDark '#050b16'",
    "native:assets": "npm run native:assets:android && npm run native:assets:ios",
    "native:sync": "npm run build && npx cap sync"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/ios": "^8.2.0",
    "@ionic/angular": "^8.8.1",
    "@ionic/angular-toolkit": "^12.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/assets": "^3.0.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
